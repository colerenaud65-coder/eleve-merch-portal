# Élevé Select — copy to .env.local for local work.
# Never commit real keys. On Vercel these come from the Marketplace
# integrations (Clerk and Neon), not from this file.

# Neon Postgres. Use the pooled connection string (host contains "-pooler")
# provisioned by the Neon integration on the Vercel project.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Clerk. Provisioned by the Clerk integration on the Vercel project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Optional. Clerk Dashboard → Webhooks, pointing at /api/webhooks/clerk.
# Accounts also sync the first time someone signs in, so this can wait.
CLERK_WEBHOOK_SECRET=

# Public origin baked into pickup QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the age-gate cookie. Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-string

# Interac e-Transfer address shown on deposit instructions.
# Set this to the real mailbox before any customer sends a deposit.
ETRANSFER_RECIPIENT=payments@eleve.select

# The first Clerk user with this email is approved as admin.
# Set it to Cole's real inbox before that account signs in.
ADMIN_EMAIL=cole@eleve.select

# Local only. Ignored when NODE_ENV=production or VERCEL_ENV is set,
# and ignored once CLERK_SECRET_KEY is present.
# Lets the seeded personas sign in on next dev before Clerk is provisioned.
ALLOW_DEV_PREVIEW=false
DEV_PREVIEW_SECRET=replace-with-another-long-random-string
